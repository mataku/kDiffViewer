headers = spawn.h
package = io.github.mataku.kdiffviewer.cli.spawn
---
#include <fcntl.h>
#ifdef __APPLE__
#include <crt_externs.h>
static inline char **kdv_environ(void) { return *_NSGetEnviron(); }
#else
extern char **environ;
static inline char **kdv_environ(void) { return environ; }
#endif

// On Linux, cinterop drops spawn.h declarations because platform.posix claims the header without exporting them,
// so Kotlin reaches posix_spawn through this wrapper. The child gets /dev/null for stdio and its own process group.
static inline int kdv_spawn_detached(const char *path, char *const argv[]) {
  posix_spawn_file_actions_t actions;
  posix_spawnattr_t attributes;
  pid_t pid;
  int result;
  if (posix_spawn_file_actions_init(&actions) != 0) return -1;
  if (posix_spawnattr_init(&attributes) != 0) {
    posix_spawn_file_actions_destroy(&actions);
    return -1;
  }
  result = posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", O_RDONLY, 0);
  if (result == 0) result = posix_spawn_file_actions_addopen(&actions, 1, "/dev/null", O_WRONLY, 0);
  if (result == 0) result = posix_spawn_file_actions_addopen(&actions, 2, "/dev/null", O_WRONLY, 0);
  if (result == 0) result = posix_spawnattr_setflags(&attributes, POSIX_SPAWN_SETPGROUP);
  if (result == 0) result = posix_spawnattr_setpgroup(&attributes, 0);
  if (result == 0) result = posix_spawn(&pid, path, &actions, &attributes, argv, kdv_environ());
  posix_spawnattr_destroy(&attributes);
  posix_spawn_file_actions_destroy(&actions);
  return result;
}
